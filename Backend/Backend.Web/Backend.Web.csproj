<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateFrontendTypesOnBuild>true</GenerateFrontendTypesOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
        <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.3.0" />
        <PackageReference Include="TypeGen" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Backend.Database\Backend.Database.csproj" />
    </ItemGroup>

    <UsingTask
        TaskName="SyncFrontendTypesTask"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <GeneratedRoot ParameterType="System.String" Required="true" />
            <TypesFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                if (!Directory.Exists(GeneratedRoot))
                {
                    Log.LogWarning($"TypeGen output directory not found: {GeneratedRoot}");
                }
                else
                {
                    if (File.Exists(TypesFile))
                    {
                        File.Delete(TypesFile);
                        Log.LogMessage(MessageImportance.High, $"Removed legacy frontend types alias file at {TypesFile}");
                    }

                    var importRegex = new Regex(@"(?m)^import\s+\{", RegexOptions.Compiled);
                    var generatedFiles = Directory.GetFiles(GeneratedRoot, "*.ts", SearchOption.TopDirectoryOnly);

                    foreach (var filePath in generatedFiles)
                    {
                        var fileContent = File.ReadAllText(filePath, Encoding.UTF8);
                        var normalizedContent = fileContent.TrimStart('\uFEFF');
                        var updatedContent = importRegex.Replace(normalizedContent, "import type {");

                        if (updatedContent == fileContent)
                        {
                            continue;
                        }

                        File.WriteAllText(filePath, updatedContent, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                        Log.LogMessage(MessageImportance.High, $"Updated type-only imports in {Path.GetFileName(filePath)}");
                    }
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateFrontendTypes" AfterTargets="Build" Condition="'$(GenerateFrontendTypesOnBuild)' == 'true'">
        <Message Text="Generating TypeScript types from DTOs..." Importance="high" />
        <Exec
            Command="dotnet tool restore"
            WorkingDirectory="$(MSBuildProjectDirectory)\.."
            ContinueOnError="WarnAndContinue" />
        <Exec
            Command="dotnet tool run dotnet-typegen -- generate -p &quot;$(MSBuildProjectDirectory)&quot; -c &quot;$(MSBuildProjectDirectory)/tgconfig.json&quot;"
            WorkingDirectory="$(MSBuildProjectDirectory)\.."
            ContinueOnError="WarnAndContinue" />
        <SyncFrontendTypesTask
            GeneratedRoot="$(MSBuildProjectDirectory)\..\..\Backoffice\app\generated-types"
            TypesFile="$(MSBuildProjectDirectory)\..\..\Backoffice\app\types.ts" />
    </Target>

</Project>
